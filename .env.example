# Required for the default data source (OMDb)
# Free key: https://www.omdbapi.com/apikey.aspx
OMDB_API_KEY=

# Optional — enables the TMDB source in the UI switcher
# https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# Local Node default is 8090 (8080 is often taken).
PORT=8090
CACHE_DIR=./cache

# Host port published by docker-compose (maps to container PORT 8080).
# Default 8080. Older compose used 580 as a nonstandard host mapping leftover.
HOST_PORT=8080
